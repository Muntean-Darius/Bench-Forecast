# =============================================================================
# LLM Provider (groq or ollama; defaults to ollama for local inference)
# =============================================================================
LLM_PROVIDER=ollama
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# PostgreSQL Database (migrated from SQLite)
# Spin up locally: docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bench_forecast
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# =============================================================================
# Legacy SQLite (kept for existing mock data tooling)
# =============================================================================
SQLITE_DB_PATH=./data/mock_db.sqlite

# =============================================================================
# Vector Store (ChromaDB)
# =============================================================================
CHROMA_PERSIST_DIR=./data/chroma_store

# =============================================================================
# LangSmith Tracing (standard LangChain env vars — read automatically)
# Get your API key at https://smith.langchain.com
# =============================================================================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=bench-forecast
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# =============================================================================
# Legacy Arize Phoenix Tracing (optional, kept for backward compat)
# =============================================================================
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
ENABLE_PHOENIX=false

# =============================================================================
# FastAPI Server
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
