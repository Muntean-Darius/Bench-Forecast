# =============================================================================
# LLM Provider: ollama | groq | openai_compatible
#   - ollama            : local inference (default)
#   - groq              : Groq API
#   - openai_compatible : any OpenAI /chat/completions endpoint (OpenCode Go,
#                         vLLM, LM Studio, Together, ...). Set the three LLM_* vars.
# Embeddings always come from Ollama (nomic-embed-text) regardless of provider.
# =============================================================================
LLM_PROVIDER=ollama
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# --- OpenAI-compatible provider (used when LLM_PROVIDER=openai_compatible) ---
# Example (OpenCode Go):
#   LLM_BASE_URL=https://opencode.ai/inference/go/v1
#   LLM_API_KEY=<your-go-key>
#   LLM_MODEL=deepseek-v4.1-flash
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Number of concurrent LLM calls fired per node (raise OLLAMA_NUM_PARALLEL to benefit)
FORECAST_LLM_PARALLELISM=4

# =============================================================================
# PostgreSQL Database (migrated from SQLite)
# Spin up locally: docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bench_forecast
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# =============================================================================
# Legacy SQLite (kept for existing mock data tooling)
# =============================================================================
SQLITE_DB_PATH=./data/mock_db.sqlite

# =============================================================================
# Vector Store (ChromaDB)
# =============================================================================
CHROMA_PERSIST_DIR=./chroma_data

# =============================================================================
# LangSmith Tracing (standard LangChain env vars — read automatically)
# Get your API key at https://smith.langchain.com
# =============================================================================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=bench-forecast
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# =============================================================================
# AI Observability Platform (ai-observability-sdk)
# Dashboard -> Projects -> <project> -> Ingest API keys -> Add key.
# The key is shown once; the API key identifies the project (do NOT set
# AI_OBSERVABILITY_PROJECT_ID in production).
#
# Endpoint: the platform base URL (the SDK appends /v1/traces itself).
#   Local docker platform stack : http://localhost:8000   <-- see note below
#   Production                  : your deployment's base URL
#
# NOTE: Bench Forecast itself defaults to API_PORT=8000, which collides with
# the local platform stack. If both run on this machine, move one of them
# (e.g. API_PORT=8001 below) or point AI_OBSERVABILITY_ENDPOINT at the
# platform's actual URL.
# =============================================================================
AI_OBSERVABILITY_API_KEY=
AI_OBSERVABILITY_ENDPOINT=
# Defaults to true when a key or endpoint is set. Set false to disable tracing
# without removing the credentials.
# AI_OBSERVABILITY_ENABLED=false
# Payload capture is opt-in (prompts/responses never leave the app by default).
AI_OBSERVABILITY_CAPTURE_PROMPTS=false
# Content-free loop measurement (repeated LLM/tool calls). Set false to disable.
AI_OBSERVABILITY_LOOP_DETECTION=true
# The app uses LangChain's ChatOllama/ChatGroq wrappers. The SDK's raw
# ollama/groq interceptors are therefore disabled by default to avoid a second
# (duplicate) LLM span per call. Set true only if you add direct client calls.
# AI_OBSERVABILITY_RAW_CLIENT_TRACING=true
# Estimate missing prompt-token counts with tiktoken (requires the [tiktoken]
# extra). Useful when the provider does not report usage.
# AI_OBSERVABILITY_BACKFILL_TIKTOKEN=1

# =============================================================================
# Legacy Arize Phoenix Tracing (optional, kept for backward compat)
# Disabled automatically while the AI Observability Platform SDK is active.
# =============================================================================
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
ENABLE_PHOENIX=false

# =============================================================================
# FastAPI Server
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
