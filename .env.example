# =============================================================================
# Bench Forecast — single project environment file
#
# Copy this file to `.env` at the repository root:
#     cp .env.example .env
#
# The backend (bench_forecast/) loads this file via src/core/config.py.
# The frontend (frontend/) reads only the VITE_* variables through its Vite
# config. Never commit `.env`.
# =============================================================================

# ---------------------------------------------------------------------------
# LLM Provider: ollama | groq | openai_compatible
#   - ollama            : local inference (default)
#   - groq              : Groq API
#   - openai_compatible : any OpenAI-compatible /chat/completions endpoint
# Embeddings always come from Ollama (nomic-embed-text) for this project.
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama
GROQ_API_KEY=
# Current Groq models: openai/gpt-oss-120b (recommended), openai/gpt-oss-20b,
# qwen/qwen3.8-27b. Llama 3.1/3.3 models are deprecated on Groq.
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
# Lower temperature keeps JSON decisions stable.
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=4
LLM_TIMEOUT=60

# --- OpenAI-compatible provider (used when LLM_PROVIDER=openai_compatible) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Concurrent LLM calls fired per forecast node. Groq's free tier has a tight
# tokens-per-minute budget, so 1 is safest; raise only with a paid tier.
FORECAST_LLM_PARALLELISM=1

# Maximum candidates shown to the LLM per role (small models lose accuracy on
# long prompts). The full ranked pool is still used for deterministic fallbacks.
FORECAST_MAX_PROMPT_CANDIDATES=4

# Candidates assessed by the skill_matcher per demand.
SKILL_MATCH_TOP_K=6

# Retry Groq 429/TPM errors using the delay suggested by the API.
LLM_RATE_LIMIT_RETRIES=5
LLM_RATE_LIMIT_MAX_WAIT=45

# Hard margin floor. No allocation/training is proposed below this percentage.
FORECAST_MIN_ACCEPTABLE_MARGIN=0

# How the decider resolves skill fit vs target margin:
#   balanced | margin_first | skill_first
FORECAST_DECISION_POLICY=balanced
# In balanced mode, accept a below-target candidate only when its skill coverage
# beats the best target-margin candidate by at least this fraction (0-1).
FORECAST_BALANCED_SKILL_ADVANTAGE=0.2

# Optional LLM-written plan narrative. Off by default: the deterministic audit
# summary is accurate and cannot hallucinate employee names or roles.
FORECAST_LLM_REASONING=false

# ---------------------------------------------------------------------------
# PostgreSQL — the Docker Compose service is the source of truth.
#
# The host port is 5434, not 5432, on purpose: a locally installed PostgreSQL
# (Homebrew, Postgres.app, etc.) commonly owns 127.0.0.1:5432 and would
# silently serve stale data. Keep these values in sync with docker-compose.yml.
# ---------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_DB=bench_forecast
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---------------------------------------------------------------------------
# ChromaDB / vector store
# CHROMA_PERSIST_DIR is resolved relative to bench_forecast/.
# ---------------------------------------------------------------------------
CHROMA_HOST=localhost
CHROMA_PORT=8200
CHROMA_PERSIST_DIR=./chroma_data

# ---------------------------------------------------------------------------
# MinIO / S3-compatible object storage
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=bench-docs
MINIO_USE_SSL=false

# ---------------------------------------------------------------------------
# Authentication (JWT)
# ---------------------------------------------------------------------------
# Must be at least 32 bytes for HS256. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# ---------------------------------------------------------------------------
# Email notifications (asynchronous outbox)
#   EMAIL_PROVIDER=console  logs emails and is safe for local development.
#   EMAIL_PROVIDER=smtp     requires SMTP_HOST / SMTP_PORT / credentials.
#   EMAIL_PROVIDER=sendgrid requires SENDGRID_API_KEY.
# Delivery failures are recorded in email_notifications and never roll back
# the underlying allocation / CV / training transaction.
# ---------------------------------------------------------------------------
EMAILS_ENABLED=true
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@bench-forecast.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=15
SENDGRID_API_KEY=
# Reserved for a future scheduled scan. In the current release, trigger the
# admin endpoint /api/v1/notifications/capacity-scan manually (or from cron).
CAPACITY_SCAN_INTERVAL_HOURS=0

# ---------------------------------------------------------------------------
# LangSmith tracing (optional; standard LangChain env vars)
# ---------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=bench-forecast
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ---------------------------------------------------------------------------
# AI Observability Platform (ai-observability-sdk)
#
# Dashboard -> Projects -> <project> -> Ingest API keys -> Add key.
# The API key identifies the project; do NOT set AI_OBSERVABILITY_PROJECT_ID
# in normal use. The SDK appends /v1/traces to the endpoint itself.
# ---------------------------------------------------------------------------
AI_OBSERVABILITY_API_KEY=
AI_OBSERVABILITY_ENDPOINT=
# Defaults to true when a key or endpoint is set.
# AI_OBSERVABILITY_ENABLED=false
# Preflight the collector before init; an unreachable/5xx endpoint disables
# tracing for the process instead of retrying OTLP batches forever.
# AI_OBSERVABILITY_PREFLIGHT=true
# Prompt/response capture is opt-in. Enable only when you need payloads.
AI_OBSERVABILITY_CAPTURE_PROMPTS=false
AI_OBSERVABILITY_LOOP_DETECTION=true
# This app uses ChatOllama/ChatGroq, so the SDK's raw client interceptors are
# disabled to avoid duplicate LLM spans. Enable only for direct client calls.
# AI_OBSERVABILITY_RAW_CLIENT_TRACING=true
# AI_OBSERVABILITY_BACKFILL_TIKTOKEN=1

# ---------------------------------------------------------------------------
# Legacy Arize Phoenix tracing (optional; skipped while the platform SDK runs)
# ---------------------------------------------------------------------------
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
ENABLE_PHOENIX=false

# ---------------------------------------------------------------------------
# FastAPI backend
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# ---------------------------------------------------------------------------
# Frontend dev server (Vite)
# Only VITE_* variables are exposed to the browser. This is the backend URL
# the Vite dev server proxies /api and /health to.
# ---------------------------------------------------------------------------
VITE_API_PROXY_TARGET=http://localhost:8000
