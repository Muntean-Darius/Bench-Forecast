# =============================================================================
# Bench Forecast — Environment Variables
# Copy to .env and fill in your values.
# NEVER commit the actual .env file to git.
# =============================================================================

# ---------------------------------------------------------------------------
# LLM Configuration
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama                       # groq | ollama
GROQ_API_KEY=                             # Required if LLM_PROVIDER=groq
GROQ_MODEL=llama-3.1-70b-versatile
OLLAMA_MODEL=llama3:8b
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text          # Used by ChromaDB ingestion pipeline

# ---------------------------------------------------------------------------
# PostgreSQL (matches docker-compose.yml defaults)
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bench_forecast
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---------------------------------------------------------------------------
# ChromaDB (matches docker-compose.yml defaults)
# ---------------------------------------------------------------------------
CHROMA_HOST=localhost
CHROMA_PORT=8200
CHROMA_PERSIST_DIR=./data/chroma_store    # Only used in local persistent mode (no Docker)

# ---------------------------------------------------------------------------
# MinIO / S3 object storage (matches docker-compose.yml defaults)
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=bench-docs
MINIO_USE_SSL=false

# ---------------------------------------------------------------------------
# Arize Phoenix observability
# ---------------------------------------------------------------------------
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
ENABLE_PHOENIX=false                      # Set true to send OTLP traces to Phoenix

# ---------------------------------------------------------------------------
# LangSmith tracing (optional, paid service)
# ---------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=bench-forecast
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ---------------------------------------------------------------------------
# FastAPI
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
